{
    "tasks": [
      {
        "type": "cppbuild",
        "label": "C/C++: g++.exe build active file",
        "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
        "args": [
          "-fdiagnostics-color=always",
          "-ggdb3",
          // "-g",
          "-O0",
          "-D_GLIBCXX_DEBUG",
          "-D CLI",
          // "-fsanitize=address,undefined",
          "-ftrapv",
          "-std=gnu++20",
          "-Wall",
          "-Wextra",
          "-Wshadow",
          "-Wno-sign-compare",
          "-Wconversion",
          "-Wlogical-op",
          "${file}",
          "-o",
          "${fileDirname}\\${fileBasenameNoExtension}.exe"
        ],
        "options": {
          "cwd": "${fileDirname}"
        },
        "problemMatcher": ["$gcc"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "detail": "Task generated by Debugger."
      }
    ],
    "version": "2.0.0"
  }
  